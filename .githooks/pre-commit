#!/bin/sh

files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$files" ]; then
  exit 0
fi

secret_patterns='(accessKeySecret|accessKeyId|secret[_-]?key|api[_-]?key|private[_-]?key|BEGIN (RSA|DSA|EC|OPENSSH)? ?PRIVATE KEY|password: *[^${[:space:]]|login-password: *[^${[:space:]]|token: *[^${[:space:]]|AKIA[0-9A-Z]{16})'

matches=$(printf '%s\n' "$files" | grep -Ev '(^|)(\.githooks/pre-commit)$|(^|/)(target|build)/|(^|/)logs/|\.class$|\.jar$|\.png$|\.jpg$|\.jpeg$|\.gif$|\.ico$' | xargs -r grep -nIE "$secret_patterns")

if [ -n "$matches" ]; then
  echo "Commit blocked: possible secrets were found in staged files."
  echo
  echo "$matches"
  echo
  echo "Move real secrets to environment variables or local ignored config, then stage again."
  exit 1
fi

exit 0
