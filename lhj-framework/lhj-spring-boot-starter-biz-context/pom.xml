        <artifactId>lhj-framework</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.lhj.framework.biz.context</groupId>
    <artifactId>lhj-spring-boot-starter-biz-context</artifactId>
